{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@12.3.4 install --frozen-lockfile",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "mcp": {
      "root": "packages/mcp",
      "runtime": "node",
      "buildCommand": "pnpm run build"
    }
  },
  "rewrites": [
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
